#: src/main.rs:63
msgid ""
"Usage: ualias [OPTION]... [SERIAL [NAME]]\n"
"Look up or append a USB device alias in /etc/udev/ualias.d/*.\n"
"Without --name (or NAME), print the matching alias. With a name, append to ualias.d/local.\n"
msgstr ""
"Usage : ualias [OPTION]... [SERIAL [NOM]]\n"
"Rechercher ou ajouter un alias de périphérique USB dans /etc/udev/ualias.d/*.\n"
"Sans --name (ou NOM), afficher l'alias correspondant. Avec un nom, ajouter dans ualias.d/local.\n"

