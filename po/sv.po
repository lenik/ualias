#: src/main.rs:63
msgid ""
"Usage: ualias [OPTION]... [SERIAL [NAME]]\n"
"Look up or append a USB device alias in /etc/udev/ualias.d/*.\n"
"Without --name (or NAME), print the matching alias. With a name, append to ualias.d/local.\n"
msgstr ""
"Användning: ualias [ALTERNATIV]... [SERIENR [NAMN]]\n"
"Slå upp eller lägg till ett USB-enhetsalias i /etc/udev/ualias.d/*.\n"
"Utan --name (eller NAMN), skriv det matchande aliaset. Med ett namn, lägg till i ualias.d/local.\n"

