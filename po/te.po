#: src/main.rs:63
msgid ""
"Usage: ualias [OPTION]... [SERIAL [NAME]]\n"
"Look up or append a USB device alias in /etc/udev/devices.\n"
"Without --name (or NAME), print the matching alias. With a name, append a pattern.\n"
msgstr ""
"వాడుక: ualias [ఎంపిక]... [సీరియల్ [పేరు]]\n"
"/etc/udev/devices లో USB పరికర మారుపేరు వెతకండి లేదా జోడించండి.\n"
"--name (లేదా పేరు) లేకుంటే సరిపోయే మారుపేరు ముద్రించండి. పేరు ఉంటే నమూనా జోడించండి.\n"

#: src/main.rs:68
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "దోషాలను నివేదించండి: <%s>\n"

#: src/main.rs:74 src/main.rs:142
msgid "USB vendor id (hex)\n"
msgstr "USB విక్రేత ID (hex)\n"

#: src/main.rs:75 src/main.rs:153
msgid "USB product id (hex)\n"
msgstr "USB ఉత్పత్తి ID (hex)\n"

#: src/main.rs:76 src/main.rs:164
msgid "device serial / MAC\n"
msgstr "పరికర సీరియల్ / MAC\n"

#: src/main.rs:77 src/main.rs:175
msgid "alias name (append mode)\n"
msgstr "మారుపేరు (జోడింపు రీతి)\n"

#: src/main.rs:78 src/main.rs:186
msgid "uppercase the first letter of the name\n"
msgstr "పేరు మొదటి అక్షరాన్ని పెద్దగా చేయి\n"

#: src/main.rs:79 src/main.rs:197
msgid "display this help and exit\n"
msgstr "ఈ సహాయం చూపి నిష్క్రమించు\n"

#: src/main.rs:80 src/main.rs:207
msgid "output version information and exit\n"
msgstr "వెర్షన్ సమాచారం చూపి నిష్క్రమించు\n"

#: src/main.rs:88
#, c-format
msgid "Copyright (C) %d %s\n"
msgstr "కాపీరైట్ (C) %d %s\n"

#: src/main.rs:92
msgid "License AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"
msgstr "లైసెన్స్ AGPL-3.0-or-later: <https://www.gnu.org/licenses/agpl-3.0.html>\n"

#: src/main.rs:93
msgid "This is free software: you are free to change and redistribute it.\n"
msgstr "ఇది స్వేచ్ఛా సాఫ్ట్‌వేర్: మీరు మార్చవచ్చు, పునఃపంపిణీ చేయవచ్చు.\n"

#: src/main.rs:94
msgid "This project opposes AI exploitation and AI hegemony.\n"
msgstr "ఈ ప్రాజెక్ట్ AI దోపిడీ మరియు AI ఆధిపత్యాన్ని వ్యతిరేకిస్తుంది.\n"

#: src/main.rs:96
msgid "This project rejects mindless MIT-style licensing and politically naive BSD-style licensing.\n"
msgstr "ఈ ప్రాజెక్ట్ నిర్లక్ష్య MIT-శైలి లైసెన్సింగ్ మరియు రాజకీయంగా అమాయక BSD-శైలి లైసెన్సింగ్‌ను తిరస్కరిస్తుంది.\n"

#: src/main.rs:98
msgid "There is NO WARRANTY, to the extent permitted by law.\n"
msgstr "చట్టం అనుమతించిన మేరకు ఎలాంటి వారంటీ లేదు.\n"

#: src/main.rs:215
msgid "device serial / MAC"
msgstr "పరికర సీరియల్ / MAC"

#: src/main.rs:220
