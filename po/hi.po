#: src/main.rs:63
msgid ""
"Usage: ualias [OPTION]... [SERIAL [NAME]]\n"
"Look up or append a USB device alias in /etc/udev/ualias.d/*.\n"
"Without --name (or NAME), print the matching alias. With a name, append to ualias.d/local.\n"
msgstr ""
"प्रयोग: ualias [विकल्प]... [सीरियल [नाम]]\n"
"/etc/udev/ualias.d/* में USB डिवाइस उपनाम खोजें या जोड़ें।\n"
"बिना --name (या नाम) मिलान उपनाम छापें। नाम होने पर ualias.d/local में जोड़ें।\n"

#: src/main.rs:68
#, c-format
msgid "Report bugs to: <%s>\n"
msgstr "बग रिपोर्ट करें: <%s>\n"

